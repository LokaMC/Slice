+package io.papermc.paper.event.entity;
+
+import org.bukkit.entity.Entity;
+import org.bukkit.event.Cancellable;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.entity.EntityEvent;
+import org.jetbrains.annotations.ApiStatus;
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Modifiable event called when an entity is about to receive knockback.
+ */
+@NullMarked
+public class EntityPreKnockbackByEntityEvent extends EntityEvent implements Cancellable {
+
+    private static final HandlerList HANDLER_LIST = new HandlerList();
+
+    private float knockback;
+    private final Entity damager;
+    private boolean cancelled;
+
+    @ApiStatus.Internal
+    public EntityPreKnockbackByEntityEvent(final Entity damager, final Entity damagee, final float knockback) {
+        super(damagee);
+        this.damager = damager;
+        this.knockback = knockback;
+    }
+
+    /**
+     * Gets the knockback force that will be applied to the entity.
+     *
+     * @return the knockback
+     */
+    public float getKnockback() {
+        return this.knockback;
+    }
+
+    /**
+     * Sets the knockback force that will be applied to the entity.
+     *
+     * @param knockback the knockback
+     */
+    public void setKnockback(final float knockback) {
+        this.knockback = knockback;
+    }
+
+    public Entity getDamager() {
+        return damager;
+    }
+
+    @Override
+    public boolean isCancelled() {
+        return this.cancelled;
+    }
+
+    @Override
+    public void setCancelled(final boolean cancel) {
+        this.cancelled = cancel;
+    }
+
+    @Override
+    public HandlerList getHandlers() {
+        return HANDLER_LIST;
+    }
+
+    public static HandlerList getHandlerList() {
+        return HANDLER_LIST;
+    }
+}
