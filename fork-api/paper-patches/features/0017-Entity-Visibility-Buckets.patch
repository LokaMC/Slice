From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Sat, 18 Apr 2026 18:28:10 -0500
Subject: [PATCH] Entity Visibility Buckets


diff --git a/src/main/java/org/bukkit/entity/Entity.java b/src/main/java/org/bukkit/entity/Entity.java
index 6215e2773ec41782db8a66e49661462dd01ff145..0b3f832f08ea61945b3c496fcf65220bd1c2fc74 100644
--- a/src/main/java/org/bukkit/entity/Entity.java
+++ b/src/main/java/org/bukkit/entity/Entity.java
@@ -1386,4 +1386,131 @@ public interface Entity extends Metadatable, CommandSender, Nameable, Persistent
      */
     void setDespawnTime(int ticks);
     // Slice end
+
+    // Slice start - asymmetric visibility buckets (two bitmasks per entity)
+    // Each bit position (0-63) names one bucket. An entity carries two masks:
+    //   - canSeeBuckets    : the set of buckets this entity is authorized to view ("keys").
+    //   - visibleToBuckets : the set of buckets this entity belongs to ("locks").
+    //
+    // Visibility rule (per direction; viewer A looking at target B):
+    //   visible == (B.visibleToBuckets == 0) || (A.canSeeBuckets & B.visibleToBuckets) != 0
+    //
+    // i.e. targets with no membership are public; otherwise the viewer must hold at least
+    // one bit the target advertises. Asymmetric scenarios are expressed by an entity
+    // putting a bucket bit in canSee but not in visibleTo (or vice versa).
+    //
+    // Examples:
+    //   - default entity (canSee=0, visibleTo=0): public, sees nothing bucketed.
+    //   - regular player: canSee=REGULAR, visibleTo=REGULAR. Sees and is seen by regulars.
+    //   - vanished admin: canSee=VANISH|REGULAR, visibleTo=VANISH. Sees everyone; only
+    //     other VANISH-aware viewers see them.
+    //   - hidden group member who is also in a party: canSee=GROUP|REGULAR|PARTY,
+    //     visibleTo=GROUP|PARTY. Group-mates and party-mates see them; strangers don't.
+
+    /**
+     * @return bitmask of buckets this entity can see ("keys"). 0 means it sees only
+     *         entities whose {@code visibleToBuckets} is also 0 (i.e. only public entities).
+     */
+    long getCanSeeBuckets();
+
+    /**
+     * Sets the bitmask of buckets this entity is authorized to view. Each set bit
+     * grants this entity the ability to see any target whose {@code visibleToBuckets}
+     * includes that bit.
+     *
+     * @param mask new can-see bitmask
+     */
+    void setCanSeeBuckets(long mask);
+
+    /**
+     * Replaces this entity's can-see mask from a list of bucket indices (each in {@code [0, 64)}).
+     * Equivalent to {@code setCanSeeBuckets((1L << b0) | (1L << b1) | ...)}.
+     *
+     * <p>Note: due to Java overload resolution, a single-argument call like
+     * {@code setCanSeeBuckets(5)} routes to {@link #setCanSeeBuckets(long)} treating
+     * {@code 5} as a raw mask (bits 0 and 2), not bucket index 5. To use this varargs
+     * overload with a single index, call {@code setCanSeeBuckets(new long[]{5})} or
+     * use {@link #addCanSeeBucket(int)} instead.</p>
+     *
+     * @param buckets bucket indices to combine into the new can-see mask
+     */
+    void setCanSeeBuckets(long... buckets);
+
+    /**
+     * @return bitmask of buckets this entity belongs to ("locks"). 0 means the entity
+     *         is public and visible to every viewer.
+     */
+    long getVisibleToBuckets();
+
+    /**
+     * Sets the bitmask of buckets this entity belongs to. A viewer sees this entity
+     * iff their {@code canSeeBuckets} shares at least one bit with this mask, or this
+     * mask is 0 (public).
+     *
+     * @param mask new visible-to bitmask; 0 makes this entity public
+     */
+    void setVisibleToBuckets(long mask);
+
+    /**
+     * Replaces this entity's visible-to mask from a list of bucket indices (each in {@code [0, 64)}).
+     * Equivalent to {@code setVisibleToBuckets((1L << b0) | (1L << b1) | ...)}.
+     *
+     * <p>Note: see overload-resolution caveat on {@link #setCanSeeBuckets(long...)}.</p>
+     *
+     * @param buckets bucket indices to combine into the new visible-to mask
+     */
+    void setVisibleToBuckets(long... buckets);
+
+    /**
+     * Adds the given bucket (0-63) to this entity's can-see mask.
+     */
+    void addCanSeeBucket(int bucket);
+
+    /**
+     * Adds the given bucket (0-63) to this entity's visible-to mask.
+     */
+    void addVisibleToBucket(int bucket);
+
+    /**
+     * Removes the given bucket (0-63) from this entity's can-see mask.
+     */
+    void removeCanSeeBucket(int bucket);
+
+    /**
+     * Removes the given bucket (0-63) from this entity's visible-to mask.
+     */
+    void removeVisibleToBucket(int bucket);
+
+    /**
+     * @return whether this entity holds the given bucket (0-63) in its can-see mask
+     */
+    boolean isInCanSeeBucket(int bucket);
+
+    /**
+     * @return whether this entity holds the given bucket (0-63) in its visible-to mask
+     */
+    boolean isInVisibleToBucket(int bucket);
+
+    /**
+     * Adds the given bucket (0-63) to <strong>both</strong> the can-see and visible-to masks.
+     * Use this for symmetric membership: this entity can see, and is seen by, every entity
+     * with the same bucket set on both masks.
+     *
+     * @param bucket bucket index (0-63)
+     */
+    default void addVisibilityBucket(int bucket) {
+        this.addCanSeeBucket(bucket);
+        this.addVisibleToBucket(bucket);
+    }
+
+    /**
+     * Removes the given bucket (0-63) from <strong>both</strong> the can-see and visible-to masks.
+     *
+     * @param bucket bucket index (0-63)
+     */
+    default void removeVisibilityBucket(int bucket) {
+        this.removeCanSeeBucket(bucket);
+        this.removeVisibleToBucket(bucket);
+    }
+    // Slice end
 }
