diff --git a/src/main/java/org/bukkit/World.java b/src/main/java/org/bukkit/World.java
index 08665309afb170c8711f70422bd013974ac48d09..08732a248b91cf006702b7db16c7a856d2fb0fa7 100644
--- a/src/main/java/org/bukkit/World.java
+++ b/src/main/java/org/bukkit/World.java
@@ -2927,6 +2927,16 @@ public interface World extends RegionAccessor, WorldInfo, PluginMessageRecipient
     public void setShardedFight(boolean value);
     // Slice end
 
+    // Slice start
+    /**
+     * Offsets which tick within the autosave interval this world's full save
+     * (level.dat write) runs on, so many worlds don't all save on the same tick.
+     * Only meaningful in [0, ticks-per.autosave); 0 (default) = vanilla timing.
+     */
+    public int getAutoSaveOffsetTicks();
+    public void setAutoSaveOffsetTicks(int ticks);
+    // Slice end
+
     /**
      * Sets the Difficulty of the world.
      *
