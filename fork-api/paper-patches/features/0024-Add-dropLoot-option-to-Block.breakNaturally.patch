@@ -567,6 +567,18 @@ public interface Block extends Metadatable, Translatable, net.kyori.adventure.tr
      */
     boolean breakNaturally(boolean triggerEffect, boolean dropExperience);
 
+    // Slice
+    /**
+     * Breaks the block and spawns item drops as if a player had broken it
+     *
+     * @param triggerEffect Play the block break particle effect and sound
+     * @param dropLoot drop loot if the block normally does so
+     * @param dropExperience drop exp if the block normally does so
+     * @return true if the block was destroyed
+     */
+    boolean breakNaturally(boolean triggerEffect, boolean dropLoot, boolean dropExperience);
+    // End Slice
+
     /**
      * Breaks the block and spawns item drops as if a player had broken it
      * with a specific tool
