Subject: [PATCH] Expose Entity.despawnTime


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 7457a326cb62decca2034230c1a04978aa961e8a..9fb31d822ebfd471432e0dbde47b9e3cce96c14e 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1382,4 +1382,16 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         this.entity.trackingRange = range;
     }
     // Slice end
+
+    // Slice start
+    @Override
+    public int getDespawnTime() {
+        return this.entity.despawnTime;
+    }
+
+    @Override
+    public void setDespawnTime(int ticks) {
+        this.entity.despawnTime = ticks;
+    }
+    // Slice end
 }
