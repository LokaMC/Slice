From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 14 May 2026 13:14:37 -0500
Subject: [PATCH] Entity Visibility Buckets


diff --git a/src/main/java/ca/spottedleaf/moonrise/common/misc/SingleUserAreaMap.java b/src/main/java/ca/spottedleaf/moonrise/common/misc/SingleUserAreaMap.java
index 7e85bb58b8a5de17fdab9ad3c574f2f80952e1ca..4deb435b04219972b6d6091b730d128c12b7adfd 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/misc/SingleUserAreaMap.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/misc/SingleUserAreaMap.java
@@ -87,6 +87,12 @@ public abstract class SingleUserAreaMap<T> {
             return false;
         }
 
+        // Slice start - Early out if we haven't changed chunks or view distance settings.
+        if (fromX == toX && fromZ == toZ && oldViewDistance == newViewDistance) {
+            return true;
+        }
+        // Slice end
+
         this.lastChunkX = toX;
         this.lastChunkZ = toZ;
         this.distance = newViewDistance;
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 592c4e24827f457fd14ff0fddb4be73b75b30c29..f722db233f16938129abe7594c7114cc154b6d9a 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1387,13 +1387,82 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
     }
     // Slice end
 
-    // Slice start - visibility bucket (fast path for instance buckets)
-    public int getVisibilityBucket() {
-        return this.entity.visibilityBucket;
+    // Slice start - asymmetric visibility buckets
+    @Override
+    public long getCanSeeBuckets() {
+        return this.entity.getCanSeeBuckets();
+    }
+
+    @Override
+    public void setCanSeeBuckets(long mask) {
+        this.entity.setCanSeeBuckets(mask);
+    }
+
+    @Override
+    public void setCanSeeBuckets(long... buckets) {
+        this.entity.setCanSeeBuckets(maskFromIndices(buckets));
+    }
+
+    @Override
+    public long getVisibleToBuckets() {
+        return this.entity.getVisibleToBuckets();
+    }
+
+    @Override
+    public void setVisibleToBuckets(long mask) {
+        this.entity.setVisibleToBuckets(mask);
+    }
+
+    @Override
+    public void setVisibleToBuckets(long... buckets) {
+        this.entity.setVisibleToBuckets(maskFromIndices(buckets));
+    }
+
+    private static long maskFromIndices(long[] indices) {
+        long mask = 0L;
+        for (long bucket : indices) {
+            if (bucket < 0 || bucket >= 64) {
+                throw new IllegalArgumentException("Bucket must be in [0, 64), got " + bucket);
+            }
+            mask |= 1L << bucket;
+        }
+        return mask;
+    }
+
+    @Override
+    public void addCanSeeBucket(int bucket) {
+        if (bucket < 0 || bucket >= 64) throw new IllegalArgumentException("Bucket must be in [0, 64), got " + bucket);
+        this.entity.setCanSeeBuckets(this.entity.getCanSeeBuckets() | (1L << bucket));
+    }
+
+    @Override
+    public void addVisibleToBucket(int bucket) {
+        if (bucket < 0 || bucket >= 64) throw new IllegalArgumentException("Bucket must be in [0, 64), got " + bucket);
+        this.entity.setVisibleToBuckets(this.entity.getVisibleToBuckets() | (1L << bucket));
+    }
+
+    @Override
+    public void removeCanSeeBucket(int bucket) {
+        if (bucket < 0 || bucket >= 64) throw new IllegalArgumentException("Bucket must be in [0, 64), got " + bucket);
+        this.entity.setCanSeeBuckets(this.entity.getCanSeeBuckets() & ~(1L << bucket));
+    }
+
+    @Override
+    public void removeVisibleToBucket(int bucket) {
+        if (bucket < 0 || bucket >= 64) throw new IllegalArgumentException("Bucket must be in [0, 64), got " + bucket);
+        this.entity.setVisibleToBuckets(this.entity.getVisibleToBuckets() & ~(1L << bucket));
     }
 
-    public void setVisibilityBucket(int bucket) {
-        this.entity.visibilityBucket = bucket;
+    @Override
+    public boolean isInCanSeeBucket(int bucket) {
+        if (bucket < 0 || bucket >= 64) return false;
+        return (this.entity.getCanSeeBuckets() & (1L << bucket)) != 0L;
+    }
+
+    @Override
+    public boolean isInVisibleToBucket(int bucket) {
+        if (bucket < 0 || bucket >= 64) return false;
+        return (this.entity.getVisibleToBuckets() & (1L << bucket)) != 0L;
     }
     // Slice end
 }
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 3cf25989719a2e409e9ea1b5fa2b26d71b62a949..a2a3f5f005e5b6aa639b2383c0650f5ebaf8134c 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2068,14 +2068,16 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     public boolean canSee(org.bukkit.entity.Entity entity) {
         if (this == entity) return true; // SPIGOT-7312
 
-        // Slice start - bucket fast path (works for any entity type)
-        final int myBucket = this.getVisibilityBucket();
-        final int otherBucket = entity.getVisibilityBucket();
-        if ((myBucket | otherBucket) != 0) {
-            if (myBucket != otherBucket) {
+        // Slice start - asymmetric visibility buckets
+        // Rule: targets whose visibleToBuckets == 0 are public. Otherwise the viewer
+        // must hold at least one of the target's visibleToBuckets bits in canSeeBuckets.
+        // Two-mask design lets A see B without B seeing A: A puts a bit in canSee that
+        // B has in visibleTo, while B does not put the corresponding bit in its canSee.
+        if (entity instanceof CraftEntity other) {
+            final long targetVisibleTo = other.getVisibleToBuckets();
+            if (targetVisibleTo != 0L && (this.getCanSeeBuckets() & targetVisibleTo) == 0L) {
                 return false;
             }
-            // Same non-zero bucket → fall through to the default-visibility + legacy-map check.
         }
         // Slice end
 
