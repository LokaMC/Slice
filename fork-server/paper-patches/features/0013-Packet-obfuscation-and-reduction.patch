Subject: [PATCH] Packet obfuscation and reduction


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 9d5b405cd7fad082b2f03ec21fa57bbfb3f46d72..3d08277d10b401be45f0caf8566c65ce4c5492ec 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2591,7 +2591,8 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
                 this.sendHealthUpdate();
             }
         }
-        this.getHandle().getEntityData().set(net.minecraft.world.entity.LivingEntity.DATA_HEALTH_ID, (float) this.getScaledHealth());
+        float scaledHealth = this.getScaledHealth();
+        this.getHandle().getEntityData().set(net.minecraft.world.entity.LivingEntity.DATA_HEALTH_ID, scaledHealth, scaledHealth <= 0 ? 0f : 20f); // Slice
 
         this.getHandle().maxHealthCache = this.getMaxHealth();
     }
