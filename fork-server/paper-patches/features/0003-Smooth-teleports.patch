Subject: [PATCH] Smooth teleports


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index f11ad0f2cdbb128dfa1f572903ad1b16b80c3e87..3dce641fcad5aa0045f7ecbff8aac861328a9874 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -1332,6 +1332,39 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         return this.getHandle().isShiftKeyDown();
     }
 
+    // Slice start
+    public void teleportWithoutRespawn(Location location) {
+        ServerPlayer serverPlayer = getHandle();
+        if (serverPlayer.connection == null) {
+            return;
+        }
+        if (location.getWorld() != this.getWorld() && !serverPlayer.passengers.isEmpty()) {
+            return;
+        }
+        serverPlayer.smoothWorldTeleport = true;
+        try {
+            // Fully relative teleport: position/rotation go out as deltas from current state, so the
+            // client applies them to its own predicted position instead of snapping back to the
+            // server's (velocity is likewise preserved rather than zeroed)
+            net.minecraft.world.phys.Vec3 delta = org.bukkit.craftbukkit.util.CraftLocation.toVec3(location).subtract(serverPlayer.position());
+            serverPlayer.teleport(new net.minecraft.world.level.portal.TeleportTransition(
+                ((CraftWorld) location.getWorld()).getHandle(),
+                delta,
+                net.minecraft.world.phys.Vec3.ZERO,
+                location.getYaw() - serverPlayer.getYRot(),
+                location.getPitch() - serverPlayer.getXRot(),
+                java.util.EnumSet.of(
+                    net.minecraft.world.entity.Relative.X, net.minecraft.world.entity.Relative.Y, net.minecraft.world.entity.Relative.Z,
+                    net.minecraft.world.entity.Relative.Y_ROT, net.minecraft.world.entity.Relative.X_ROT,
+                    net.minecraft.world.entity.Relative.DELTA_X, net.minecraft.world.entity.Relative.DELTA_Y, net.minecraft.world.entity.Relative.DELTA_Z),
+                net.minecraft.world.level.portal.TeleportTransition.DO_NOTHING)
+                .withCause(org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.PLUGIN));
+        } finally {
+            serverPlayer.smoothWorldTeleport = false;
+        }
+    }
+    // Slice end
+
     @Override
     public boolean isSprinting() {
         return this.getHandle().isSprinting();
