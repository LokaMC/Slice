From: Cryptite <cryptite@gmail.com>
Date: Wed, 14 Jan 2026 12:02:27 -0600
Subject: [PATCH] Unsaveable entities


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 617491c66962c8e011b0a426040ebc21ccc56740..509d55f1c24407951ce1fff9ceafc6a1d4243a22 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1374,4 +1374,16 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         return this.entity.level().getWorld().getBlockAt(pos.getX(), pos.getY(), pos.getZ());
     }
     // Slice end
+
+    // Slice start
+    @Override
+    public boolean isSaveable() {
+        return this.entity.saveable;
+    }
+
+    @Override
+    public void setSaveable(boolean saveable) {
+        this.entity.saveable = saveable;
+    }
+    // Slice end
 }
