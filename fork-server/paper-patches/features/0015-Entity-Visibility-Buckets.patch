From: Cryptite <cryptite@gmail.com>
Date: Sat, 18 Apr 2026 18:28:10 -0500
Subject: [PATCH] Entity Visibility Buckets


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 3490a6dff799cea958acea88fff2574f677e6aba..7c92361c1093473c69b257ed30f365dd9d55a421 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1422,4 +1422,14 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         this.entity.despawnTime = ticks;
     }
     // Slice end
+
+    // Slice start - visibility bucket (fast path for instance buckets)
+    public int getVisibilityBucket() {
+        return this.entity.visibilityBucket;
+    }
+
+    public void setVisibilityBucket(int bucket) {
+        this.entity.visibilityBucket = bucket;
+    }
+    // Slice end
 }
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 4f2ee2754164750bde268e76430c8c4e21f64898..f28f63f4990788d7ad7a5e690eda5dfad037cd24 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2097,7 +2097,23 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
 
     @Override
     public boolean canSee(org.bukkit.entity.Entity entity) {
-        return this.equals(entity) || entity.isVisibleByDefault() ^ this.invertedVisibilityEntities.containsKey(entity.getUniqueId()); // SPIGOT-7312: Can always see self
+        if (this == entity) return true; // SPIGOT-7312
+
+        // Slice start - bucket fast path (works for any entity type)
+        final int myBucket = this.getVisibilityBucket();
+        final int otherBucket = entity.getVisibilityBucket();
+        if ((myBucket | otherBucket) != 0) {
+            if (myBucket != otherBucket) {
+                return false;
+            }
+            // Same non-zero bucket → fall through to the default-visibility + legacy-map check.
+        }
+        // Slice end
+
+        if (this.invertedVisibilityEntities.isEmpty()) {
+            return entity.isVisibleByDefault();
+        }
+        return entity.isVisibleByDefault() ^ this.invertedVisibilityEntities.containsKey(entity.getUniqueId());
     }
 
     public boolean canSeePlayer(UUID uuid) {
