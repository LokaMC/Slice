@@ -1341,4 +1341,16 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         return this.entity.level().getWorld().getBlockAt(pos.getX(), pos.getY(), pos.getZ());
     }
     // Slice end
+
+    // Slice start
+    @Override
+    public boolean isSaveable() {
