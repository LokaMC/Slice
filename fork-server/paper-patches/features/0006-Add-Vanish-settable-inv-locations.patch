From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Wed, 14 Jan 2026 12:06:48 -0600
Subject: [PATCH] Add Vanish, settable inv locations


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
index 0bf8de195a88d5906c2db6d5b1d73aac0950f391..90d731b58c70123d90366271ea0fe0637eaa9611 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftEntity.java
@@ -1350,4 +1350,16 @@ public abstract class CraftEntity implements org.bukkit.entity.Entity {
         this.entity.saveable = saveable;
     }
     // Slice end
+
+    // Slice start
+    @Override
+    public boolean isVanished() {
+        return this.entity.vanished;
+    }
+
+    @Override
+    public void setVanished(boolean vanished) {
+        this.entity.vanished = vanished;
+    }
+    // Slice end
 }
diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java
index 680468e6c16f1015d3b3b999e61a7d322ea03561..4cc1ff5c7cb6671f22cf939dac418c08ef8c2201 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java
@@ -65,6 +65,14 @@ public class CraftInventoryCustom extends CraftInventory {
         }
     }
 
+    // Slice start
+    public void setLocation(Location location) {
+        if (this.inventory instanceof MinecraftInventory minecraftInventory) {
+            minecraftInventory.location = location;
+        }
+    }
+    // Slice end
+
     static class MinecraftInventory implements Container {
         private final NonNullList<ItemStack> items;
         private int maxStack = MAX_STACK;
@@ -73,6 +81,7 @@ public class CraftInventoryCustom extends CraftInventory {
         private final net.kyori.adventure.text.Component adventure$title; // Paper
         private InventoryType type;
         private final InventoryHolder owner;
+        private Location location; // Slice
 
         public MinecraftInventory(InventoryHolder owner, InventoryType type, net.kyori.adventure.text.Component title) {
             this(owner, type.getDefaultSize(), title);
@@ -229,7 +238,7 @@ public class CraftInventoryCustom extends CraftInventory {
 
         @Override
         public Location getLocation() {
-            return null;
+            return location;
         }
 
         public net.kyori.adventure.text.Component title() {
