From: Cryptite <cryptite@gmail.com>
Date: Thu, 15 Jan 2026 08:56:12 -0600
Subject: [PATCH] Add LeafBlockTickEvent


diff --git a/net/minecraft/world/level/block/LeavesBlock.java b/net/minecraft/world/level/block/LeavesBlock.java
index d0dba204ed4f709470d097ddf6448e432e5530bc..ddabad890dc0c9dd3de7129bbce064187909ba9c 100644
--- a/net/minecraft/world/level/block/LeavesBlock.java
+++ b/net/minecraft/world/level/block/LeavesBlock.java
@@ -57,14 +57,16 @@ public class LeavesBlock extends Block implements SimpleWaterloggedBlock {
 
     @Override
     protected boolean isRandomlyTicking(final BlockState state) {
-        return state.getValue(DISTANCE) == 7 && !state.getValue(PERSISTENT);
+        return true; //state.getValue(DISTANCE) == 7 && !state.getValue(PERSISTENT);
     }
 
     @Override
     protected void randomTick(final BlockState state, final ServerLevel level, final BlockPos pos, final RandomSource random) {
+        org.bukkit.craftbukkit.block.CraftBlock block = org.bukkit.craftbukkit.block.CraftBlock.at(level, pos);
+        new io.papermc.paper.event.block.LeafBlockTickEvent(block).callEvent();
         if (this.decaying(state)) {
             // CraftBukkit start
-            org.bukkit.event.block.LeavesDecayEvent event = new org.bukkit.event.block.LeavesDecayEvent(org.bukkit.craftbukkit.block.CraftBlock.at(level, pos));
+            org.bukkit.event.block.LeavesDecayEvent event = new org.bukkit.event.block.LeavesDecayEvent(block);
             level.getCraftServer().getPluginManager().callEvent(event);
 
             if (event.isCancelled() || !level.getBlockState(pos).is(this)) {
