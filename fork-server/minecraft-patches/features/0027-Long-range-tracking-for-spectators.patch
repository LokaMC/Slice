From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 15 Jan 2026 09:38:05 -0600
Subject: [PATCH] Long-range tracking for spectators


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index fd0b9f20fbdd523d51550fd6009b5011e6e7e6e6..b57076f1badb394bd19ed0b64d433b33cae3420a 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1414,7 +1414,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 double deltaToPlayerZ = player.getZ() - this.entity.getZ();
                 // Paper end - remove allocation of Vec3 here
                 int playerViewDistance = ChunkMap.this.getPlayerViewDistance(player);
-                double visibleRange = Math.min(this.getEffectiveRange(), playerViewDistance * 16);
+                double visibleRange = player.gameMode.getGameModeForPlayer() == net.minecraft.world.level.GameType.SPECTATOR ? 128 : Math.min(this.getEffectiveRange(), playerViewDistance * 16); // Slice
                 double distanceSquared = deltaToPlayerX * deltaToPlayerX + deltaToPlayerZ * deltaToPlayerZ; // Paper
                 double rangeSquared = visibleRange * visibleRange;
                 // Paper start - Configurable entity tracking range by Y
