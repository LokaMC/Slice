From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 19 Feb 2026 09:07:40 -0600
Subject: [PATCH] Add extraHitboxScale to entities


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 7c71104d2a3a1c68010b724a12461751553c4648..49f6e932d39a5e50b5bbc03be46925ff17cf6353 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -407,6 +407,7 @@ public abstract class Entity
     public boolean vanished; // Slice
     public int trackingRange; // Slice
     public boolean inWaterOverride; // Slice
+    public float extraHitboxAmount; // Slice
 
     public void inactiveTick() {
     }
diff --git a/net/minecraft/world/entity/projectile/ProjectileUtil.java b/net/minecraft/world/entity/projectile/ProjectileUtil.java
index 990d4b50edd40757449298640f9ee5e71daa110d..b20ad72eb0f959a6eebbb80f4172cb3c16627b1a 100644
--- a/net/minecraft/world/entity/projectile/ProjectileUtil.java
+++ b/net/minecraft/world/entity/projectile/ProjectileUtil.java
@@ -75,7 +75,7 @@ public final class ProjectileUtil {
             to = hitResult.getLocation();
         }
 
-        HitResult entityHit = getEntityHitResult(level, source, from, to, source.getBoundingBox().expandTowards(delta).inflate(1.0), matching, entityMargin);
+        HitResult entityHit = getEntityHitResult(level, source, from, to, source.getBoundingBox().expandTowards(delta).inflate(1.0 + source.extraHitboxAmount), matching, entityMargin); // Slice - widen candidate search to cover the enlarged hit margin
         if (entityHit != null) {
             hitResult = entityHit;
         }
@@ -151,7 +151,7 @@ public final class ProjectileUtil {
     }
 
     public static float computeMargin(final Entity source) {
-        return Math.max(0.0F, Math.min(0.3F, (source.tickCount - 2) / 20.0F));
+        return Math.max(0.0F, Math.min(0.3F, (source.tickCount - 2) / 20.0F)) + source.extraHitboxAmount; // Slice - let a projectile enlarge the margin its own hit-scan inflates targets by
     }
 
     public static @Nullable EntityHitResult getEntityHitResult(
