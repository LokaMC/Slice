Subject: [PATCH] Add DimensionDataStorageEvents


diff --git a/net/minecraft/world/level/storage/DimensionDataStorage.java b/net/minecraft/world/level/storage/DimensionDataStorage.java
index 1ff0b19a077333ad9da9cab7f5a891eeaa2109a9..a473b24caabf968b71fce716826d2db389292824 100644
--- a/net/minecraft/world/level/storage/DimensionDataStorage.java
+++ b/net/minecraft/world/level/storage/DimensionDataStorage.java
@@ -203,6 +203,11 @@ public class DimensionDataStorage implements AutoCloseable {
         Path dataFile = this.getDataFile(type.id());
 
         try {
+            java.io.ByteArrayOutputStream buf = new java.io.ByteArrayOutputStream();
+            NbtIo.writeCompressed(tag, buf);
+            io.papermc.paper.event.server.DimensionDataStorageSaveEvent event = new io.papermc.paper.event.server.DimensionDataStorageSaveEvent(type.id(), buf);
+            if (!event.callEvent()) return;
+
             NbtIo.writeCompressed(tag, dataFile);
         } catch (IOException var5) {
             LOGGER.error("Could not save data to {}", dataFile.getFileName(), var5);
