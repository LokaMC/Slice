Subject: [PATCH] Entity Visibility Buckets


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 68151ce05e7009f28dda0470c744920cbd5f4a27..df8d6406897d562d82cafb981ee6e485db897188 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -335,6 +335,11 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     public boolean isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
     private final Set<String> pluginsBlockingSleep = new java.util.HashSet<>(); // Paper - API to allow/disallow tick sleeping
     public static final long SERVER_INIT = System.nanoTime(); // Paper - Lag compensation
+    // Slice start - visibility bucket queue
+    public final Set<net.minecraft.world.entity.Entity> pendingVisibilityBucketWrites = new it.unimi.dsi.fastutil.objects.ReferenceLinkedOpenHashSet<>();
+    public int visibilityBucketUpdateBudgetPerTick = 5;
+    public static boolean VIS_DEBUG = false;
+    // Slice end
     // Paper start - improve tick loop
     public final ca.spottedleaf.common.time.TickData tickTimes1s  = new ca.spottedleaf.common.time.TickData(java.util.concurrent.TimeUnit.SECONDS.toNanos(1L));
     public final ca.spottedleaf.common.time.TickData tickTimes5s  = new ca.spottedleaf.common.time.TickData(java.util.concurrent.TimeUnit.SECONDS.toNanos(5L));
@@ -1811,6 +1816,46 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         profiler.push("levels");
         this.updateEffectiveRespawnData();
 
+        // Slice start - drain queued visibility bucket refresh from prior tick
+        if (!this.pendingVisibilityBucketWrites.isEmpty()) {
+            final int budget = this.visibilityBucketUpdateBudgetPerTick;
+            final int cap = (budget <= 0) ? Integer.MAX_VALUE : budget;
+            if (VIS_DEBUG) LOGGER.info("[VisDebug] drain start: queue={} cap={}", this.pendingVisibilityBucketWrites.size(), cap);
+            final java.util.Iterator<net.minecraft.world.entity.Entity> it = this.pendingVisibilityBucketWrites.iterator();
+            int drained = 0;
+            while (it.hasNext() && drained < cap) {
+                final net.minecraft.world.entity.Entity e = it.next();
+                it.remove();
+                drained++;
+                if (e.isRemoved()) {
+                    if (VIS_DEBUG && e instanceof ServerPlayer) LOGGER.info("[VisDebug] drain skip {} (removed)", e.getName().getString());
+                    continue;
+                }
+                if (!(e.level() instanceof ServerLevel level)) {
+                    if (VIS_DEBUG && e instanceof ServerPlayer) LOGGER.info("[VisDebug] drain skip {} (not in ServerLevel)", e.getName().getString());
+                    continue;
+                }
+                if (VIS_DEBUG && e instanceof ServerPlayer) LOGGER.info("[VisDebug] drain process {} canSee=0x{} visibleTo=0x{}", e.getName().getString(), Long.toHexString(e.getCanSeeBuckets()), Long.toHexString(e.getVisibleToBuckets()));
+
+                final ChunkMap chunkMap = level.getChunkSource().chunkMap;
+                final ChunkMap.TrackedEntity self = chunkMap.entityMap.get(e.getId());
+                if (self != null) {
+                    for (ServerPlayer p : level.players()) {
+                        self.updatePlayerForBucketTransition(p);
+                    }
+                } else if (VIS_DEBUG && e instanceof ServerPlayer) {
+                    LOGGER.info("[VisDebug] drain {}: no TrackedEntity in entityMap (loop 1 skipped)", e.getName().getString());
+                }
+
+                if (e instanceof ServerPlayer player) {
+                    for (ChunkMap.TrackedEntity tracked : chunkMap.entityMap.values()) {
+                        tracked.updatePlayerForBucketTransition(player);
+                    }
+                }
+            }
+        }
+        // Slice end
+
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
         for (ServerLevel level : this.getAllLevels()) {
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index d106b195c26cbed452a3caf102725c57d4868dca..cc3814ce22d0838c9cea1f70d1d0c6bcaf1bbb26 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1388,6 +1388,20 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                     if (this.seenBy.add(player.connection)) {
                         // Paper start - entity tracking events
                         if (io.papermc.paper.event.player.PlayerTrackEntityEvent.getHandlerList().getRegisteredListeners().length == 0 || new io.papermc.paper.event.player.PlayerTrackEntityEvent(player.getBukkitEntity(), this.entity.getBukkitEntity()).callEvent()) {
+                        // Slice start - guarantee PlayerInfoUpdate precedes AddEntity for bucket-managed
+                        // player targets. PlayerList#placeNewPlayer gates the join-time profile on canSee,
+                        // so a peer that was bucket-hidden at this viewer's join has no player-list entry.
+                        // The client drops an AddEntity for a player not in its list, so the unthrottled
+                        // tracker would spawn it invisibly (fixed only by relog). Sending the profile here,
+                        // in the add path, makes ordering correct no matter whether the tracker tick or the
+                        // throttled bucket drain wins the race to establish this pairing. Idempotent; gated
+                        // on the sticky usedVisibilityBuckets flag so non-bucketed entities are unaffected.
+                        if (this.entity instanceof ServerPlayer bucketTarget && bucketTarget.usedVisibilityBuckets) {
+                            if (net.minecraft.server.MinecraftServer.VIS_DEBUG) LOGGER.info("[VisDebug] defensive PlayerInfoUpdate target={} viewer={}", bucketTarget.getName().getString(), player.getName().getString());
+                            player.connection.send(net.minecraft.network.protocol.game.ClientboundPlayerInfoUpdatePacket.createPlayerInitializing(java.util.List.of(bucketTarget), player));
+                        }
+                        if (net.minecraft.server.MinecraftServer.VIS_DEBUG && this.entity instanceof ServerPlayer) LOGGER.info("[VisDebug] addPairing target={} viewer={}", this.entity.getName().getString(), player.getName().getString());
+                        // Slice end
                         this.serverEntity.addPairing(player);
                         if (this.seenBy.size() == 1) {
                             ChunkMap.this.level.debugSynchronizers().registerEntity(this.entity);
@@ -1434,5 +1448,27 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
                 this.updatePlayer(player);
             }
         }
+
+        // Slice start - bucket-driven refresh path
+        public void updatePlayerForBucketTransition(ServerPlayer player) {
+            if (this.entity == player) return;
+            if (!(this.entity instanceof ServerPlayer)) {
+                this.updatePlayer(player);
+                return;
+            }
+            final boolean wasSeen = this.seenBy.contains(player.connection);
+            final boolean canSee = player.getBukkitEntity().canSee(this.entity.getBukkitEntity());
+            if (net.minecraft.server.MinecraftServer.VIS_DEBUG && this.entity instanceof ServerPlayer) {
+                LOGGER.info("[VisDebug] transition target={} viewer={} wasSeen={} canSee={} -> {}",
+                    this.entity.getName().getString(), player.getName().getString(), wasSeen, canSee,
+                    (!wasSeen && canSee) ? "SHOW" : (wasSeen && !canSee) ? "HIDE" : "noop");
+            }
+            if (!wasSeen && canSee) {
+                player.getBukkitEntity().trackAndShowEntity(this.entity.getBukkitEntity());
+            } else if (wasSeen && !canSee) {
+                player.getBukkitEntity().untrackAndHideEntity(this.entity.getBukkitEntity());
+            }
+        }
+        // Slice end
     }
 }
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 6fe4e12088d4ffeae45afb9d8ad42fae71bfe4ee..ae356c70c062dada8f1a3c100481597a3e19a440 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -402,6 +402,77 @@ public abstract class Entity
     public int trackingRange; // Slice
     public boolean inWaterOverride; // Slice
     public float extraHitboxAmount; // Slice
+    // Slice start - visibility buckets (asymmetric: canSee = "what I see", visibleTo = "who sees me")
+    // Visibility rule: A sees B iff B.visibleToBuckets == 0 || (A.canSeeBuckets & B.visibleToBuckets) != 0.
+    // Two masks let visibility be asymmetric: an entity can choose to see groups it does not advertise into.
+    //
+    // CONSISTENCY MODEL: writes are applied to the field synchronously and reads return the latest
+    // value. The only thing deferred is the tracker refresh: setX / modifyX add this entity to
+    // MinecraftServer#pendingVisibilityBucketWrites, and the drain in tickChildren re-runs
+    // updatePlayer for nearby viewers, capped at visibilityBucketUpdateBudgetPerTick entities per
+    // tick. The cap bounds main-thread cost on mass bucket flips (e.g. 400-player gigafights);
+    // tracker refresh may lag mask updates by up to ceil(queueDepth / budget) ticks, but every
+    // canSee evaluation inside the drain reads the current field for both endpoints.
+    //
+    // THREADING: main-thread only. Callers dispatching from other threads (e.g. RabbitMQ
+    // consumers) must hop to main first via Bukkit.getScheduler().runTask(...). No synchronization
+    // is performed here; mis-using these methods off-thread will silently corrupt the queue.
+    private long canSeeBuckets = 0L;
+    private long visibleToBuckets = 0L;
+    // Sticky: set true the first time this entity ever takes a visibility-bucket write, never reset.
+    // Gates the defensive PlayerInfoUpdate in ChunkMap.TrackedEntity#updatePlayer. We cannot decide
+    // "is my profile missing from a viewer" from the current mask: a prewarper RELEASED back to public
+    // (visibleToBuckets == 0) is still absent from the list of any viewer who joined while it was
+    // hidden, because PlayerList#placeNewPlayer gated that join-time profile on canSee. Current state
+    // can't see that history, so we gate on "ever bucketed" instead. Entities that never touch buckets
+    // keep the byte-for-byte vanilla spawn path (flag stays false).
+    public boolean usedVisibilityBuckets = false;
+
+    public long getCanSeeBuckets() {
+        return this.canSeeBuckets;
+    }
+
+    public long getVisibleToBuckets() {
+        return this.visibleToBuckets;
+    }
+
+    public void setCanSeeBuckets(long mask) {
+        if (this.canSeeBuckets == mask) return;
+        this.canSeeBuckets = mask;
+        this.enqueueVisibilityBucketWrite();
+    }
+
+    public void setVisibleToBuckets(long mask) {
+        if (this.visibleToBuckets == mask) return;
+        this.visibleToBuckets = mask;
+        this.enqueueVisibilityBucketWrite();
+    }
+
+    // OR / AND-NOT primitive backing CraftEntity#addCanSeeBucket and #removeCanSeeBucket. Composes
+    // on the current field value so sequential add(1); add(2) accumulates both bits.
+    public void modifyCanSeeBuckets(long orMask, long andNotMask) {
+        final long next = (this.canSeeBuckets | orMask) & ~andNotMask;
+        if (this.canSeeBuckets == next) return;
+        this.canSeeBuckets = next;
+        this.enqueueVisibilityBucketWrite();
+    }
+
+    public void modifyVisibleToBuckets(long orMask, long andNotMask) {
+        final long next = (this.visibleToBuckets | orMask) & ~andNotMask;
+        if (this.visibleToBuckets == next) return;
+        this.visibleToBuckets = next;
+        this.enqueueVisibilityBucketWrite();
+    }
+
+    // Queue the entity for tracker refresh next tick. No-op if MinecraftServer has not initialised
+    // yet (pre-init / unit tests); in that path there are no players to refresh anyway.
+    private void enqueueVisibilityBucketWrite() {
+        this.usedVisibilityBuckets = true;
+        final net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+        if (server == null) return;
+        server.pendingVisibilityBucketWrites.add(this);
+    }
+    // Slice end
 
     public void inactiveTick() {
     }
