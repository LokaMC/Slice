From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Wed, 14 Jan 2026 12:04:40 -0600
Subject: [PATCH] Add PlayerInsertBundleItemEvent


diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index 15fc8954dca08936c7afc8fdffdc0f6fd53c78e2..c4cfb53e145d69666ffc27ef4ee0c50b54eb9143 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -576,7 +576,6 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         if (doMobSpawning && (this.spawnEnemies || this.spawnFriendlies)) { // Paper
             // Paper start - PlayerNaturallySpawnCreaturesEvent
             for (ServerPlayer player : this.level.players()) {
-                if (player.spawnsOwnMobs) continue; // Slice
                 int chunkRange = Math.min(level.spigotConfig.mobSpawnRange, player.getBukkitEntity().getViewDistance());
                 chunkRange = Math.min(chunkRange, 8);
                 player.playerNaturallySpawnedEvent = new com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent(player.getBukkitEntity(), (byte) chunkRange);
diff --git a/net/minecraft/world/item/BundleItem.java b/net/minecraft/world/item/BundleItem.java
index a9f29eb86784c1b846ef7540f1229dcdd76c662c..b3a90d7a45e05fffc675b8e97fc1c4277cee953d 100644
--- a/net/minecraft/world/item/BundleItem.java
+++ b/net/minecraft/world/item/BundleItem.java
@@ -66,6 +66,7 @@ public class BundleItem extends Item {
         ItemStack other = slot.getItem();
         BundleContents.Mutable contents = initialContents.asMutable();
         if (clickAction == ClickAction.PRIMARY && !other.isEmpty()) {
+            if (!new io.papermc.paper.event.player.PlayerInsertBundleItemEvent((org.bukkit.entity.Player) player.getBukkitEntity(), org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitMirror(self), org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitMirror(other)).callEvent()) return false; // Slice
             if (contents.tryTransfer(slot, player) > 0) {
                 playInsertSound(player);
             } else {
@@ -110,6 +111,7 @@ public class BundleItem extends Item {
 
         BundleContents.Mutable contents = initialContents.asMutable();
         if (clickAction == ClickAction.PRIMARY && !other.isEmpty()) {
+            if (!new io.papermc.paper.event.player.PlayerInsertBundleItemEvent((org.bukkit.entity.Player) player.getBukkitEntity(), org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitMirror(self), org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitMirror(other)).callEvent()) return false; // Slice
             if (slot.allowModification(player) && contents.tryInsert(other) > 0) {
                 playInsertSound(player);
             } else {
