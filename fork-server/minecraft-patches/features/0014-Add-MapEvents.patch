@@ -75,11 +78,21 @@ public class SavedDataStorage implements AutoCloseable {
 
     public <T extends SavedData> @Nullable T get(final SavedDataType<T> type) {
         Optional<SavedData> data = this.cache.get(type);
-        if (data == null) {
-            data = Optional.ofNullable(this.readSavedData(type));
-            this.cache.put(type, data);
+        if (data != null) {
+            return (T)data.orElse(null);
         }
-
+        // Slice start - async map load: never block the main thread on plugin-backed map I/O.
+        // Cache miss for a map type schedules the load on the dimension-data I/O pool and
+        // returns null for this tick; callers of getMapData already null-check and skip.
+        if (type.id().getPath().startsWith("maps/")) {
+            if (this.pendingLoads.add(type)) {
+                this.scheduleAsyncMapLoad(type);
+            }
+            return null;
+        }
+        // Slice end
+        data = Optional.ofNullable(this.readSavedData(type));
+        this.cache.put(type, data);
         return (T)data.orElse(null);
     }
 
@@ -101,7 +114,58 @@ public class SavedDataStorage implements AutoCloseable {
         return null;
     }
 
+    // Slice start - async map load
+    private <T extends SavedData> void scheduleAsyncMapLoad(final SavedDataType<T> type) {
+        CompletableFuture.runAsync(() -> {
+            CompoundTag tagFromDisk = null;
+            try {
+                int mapId = Integer.parseInt(type.id().getPath().substring("maps/".length()));
+                io.papermc.paper.event.server.MapLoadEvent event = new io.papermc.paper.event.server.MapLoadEvent(mapId);
+                event.callEvent();
+                java.io.ByteArrayInputStream buf = event.getBuf();
+                if (buf != null) {
+                    tagFromDisk = NbtIo.readCompressed(buf, NbtAccounter.unlimitedHeap());
+                } else {
+                    Path dataFile = this.getDataFile(type.id());
+                    if (Files.exists(dataFile)) {
+                        tagFromDisk = this.readTagFromDisk(
+                            dataFile, type.dataFixType(), SharedConstants.getCurrentVersion().dataVersion().version()
+                        );
+                    }
+                }
+            } catch (Exception e) {
+                LOGGER.error("Async load failed for {}", type.id(), e);
+            }
+            final CompoundTag finalTag = tagFromDisk;
+            net.minecraft.server.MinecraftServer.getServer().execute(() -> this.installLoadedMap(type, finalTag));
+        }, Util.DIMENSION_DATA_IO_POOL);
+    }
+
+    private <T extends SavedData> void installLoadedMap(final SavedDataType<T> type, final @Nullable CompoundTag tag) {
+        this.pendingLoads.remove(type);
+        // Respect any set() that arrived while we were loading.
+        if (this.cache.containsKey(type)) {
+            return;
+        }
+        if (tag == null) {
+            this.cache.put(type, Optional.empty());
+            return;
+        }
+        try {
+            RegistryOps<Tag> registryOps = this.registries.createSerializationContext(NbtOps.INSTANCE);
+            Optional<T> parsed = type.codec()
+                .parse(registryOps, tag.get("data"))
+                .resultOrPartial(string -> LOGGER.error("Failed to parse async-loaded saved data for '{}': {}", type, string));
+            this.cache.put(type, parsed.map(d -> (SavedData) d));
+        } catch (Exception e) {
+            LOGGER.error("Error installing async-loaded saved data for {}", type.id(), e);
+            this.cache.put(type, Optional.empty());
+        }
+    }
+    // Slice end
+
     public <T extends SavedData> void set(final SavedDataType<T> type, final T data) {
+        this.pendingLoads.remove(type); // Slice - async map load: a fresh set() supersedes any in-flight async load.
         this.cache.put(type, Optional.of(data));
         data.setDirty();
     }
