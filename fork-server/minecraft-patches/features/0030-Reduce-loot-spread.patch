From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 15 Jan 2026 09:39:59 -0600
Subject: [PATCH] Reduce loot spread


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index e70d645a4d1fadb293b228acc8efeec14342c7ed..b5e24e1d024312e058b46fd00d7be232d4a1dd5e 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4172,7 +4172,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             }
 
             if (randomizeMotion) {
-                float f = this.random.nextFloat() * 0.5F;
+                float f = this.random.nextFloat() * 0.3F; // Slice - Lower from 0.5 for less cartoonish loot spread
                 float f1 = this.random.nextFloat() * (float) (Math.PI * 2);
                 itemEntity.setDeltaMovement(-Mth.sin(f1) * f, 0.2F, Mth.cos(f1) * f);
             } else {
