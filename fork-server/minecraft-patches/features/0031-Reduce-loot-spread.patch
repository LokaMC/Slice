From: Cryptite <cryptite@gmail.com>
Date: Sat, 14 Jun 2025 09:03:57 -0500
Subject: [PATCH] Reduce loot spread


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index a5eee91eca2ed94ec57acae95c87889d855f70d9..0002944758f6eb3d3790c3dfd0712fdbfe2d29eb 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -2664,7 +2664,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
             }
 
             if (dropAround) {
-                float f = this.random.nextFloat() * 0.5F;
+                float f = this.random.nextFloat() * 0.3F; // Slice - Lower from 0.5 for less cartoonish loot spread
                 float f1 = this.random.nextFloat() * (float) (Math.PI * 2);
                 itemEntity.setDeltaMovement(-Mth.sin(f1) * f, 0.2F, Mth.cos(f1) * f);
             } else {
