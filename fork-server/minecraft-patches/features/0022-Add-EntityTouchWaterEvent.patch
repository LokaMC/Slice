From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 15 Jan 2026 08:57:00 -0600
Subject: [PATCH] Add EntityTouchWaterEvent


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index de5cdcd2688027577cff7eb3143cfa8822a5dc28..19e50e0a10bff1277c409f6730ca54dcaf6442e1 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -2230,7 +2230,10 @@ public abstract class Entity
             this.resetFallDistance();
             if (!this.wasTouchingWater && !this.firstTick) {
                 this.doWaterSplashEffect();
+                new io.papermc.paper.event.entity.EntityTouchWaterEvent(getBukkitEntity(), true).callEvent(); // Slice
             }
+        } else if (this.wasTouchingWater) {
+            new io.papermc.paper.event.entity.EntityTouchWaterEvent(getBukkitEntity(), false).callEvent(); // Slice
         }
 
         this.wasTouchingWater = inWater;
