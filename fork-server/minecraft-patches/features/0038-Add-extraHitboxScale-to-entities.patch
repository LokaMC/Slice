From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 19 Feb 2026 09:07:40 -0600
Subject: [PATCH] Add extraHitboxScale to entities


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index c410e0aba82ee48e633d3b9f9733a14716bb5cc5..d296e3e35ac9a2081c7c414b9654050b2830e73a 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -387,6 +387,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     public boolean vanished; // Slice
     public int trackingRange; // Slice
     public boolean inWaterOverride; // Slice
+    public float extraHitboxAmount; // Slice
 
     public void inactiveTick() {
     }
diff --git a/net/minecraft/world/entity/projectile/ProjectileUtil.java b/net/minecraft/world/entity/projectile/ProjectileUtil.java
index 00e7dd53ed4f82001b681f32e1b88495d66669d0..a6f5b1d53b025a14b580d3a71547587139e58d2a 100644
--- a/net/minecraft/world/entity/projectile/ProjectileUtil.java
+++ b/net/minecraft/world/entity/projectile/ProjectileUtil.java
@@ -70,7 +70,7 @@ public final class ProjectileUtil {
         }
 
         HitResult entityHitResult = getEntityHitResult(
-            level, source, pos, vec3, source.getBoundingBox().expandTowards(deltaMovement).inflate(1.0), filter, margin
+            level, source, pos, vec3, source.getBoundingBox().expandTowards(deltaMovement).inflate(1.0 + source.extraHitboxAmount), filter, margin // Slice - widen candidate search to cover the enlarged hit margin
         );
         if (entityHitResult != null) {
             hitResult = entityHitResult;
@@ -143,7 +143,7 @@ public final class ProjectileUtil {
     }
 
     public static float computeMargin(Entity entity) {
-        return Math.max(0.0F, Math.min(0.3F, (entity.tickCount - 2) / 20.0F));
+        return Math.max(0.0F, Math.min(0.3F, (entity.tickCount - 2) / 20.0F)) + entity.extraHitboxAmount; // Slice - let a projectile enlarge the margin its own hit-scan inflates targets by
     }
 
     public static @Nullable EntityHitResult getEntityHitResult(
