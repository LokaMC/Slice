From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 15 Jan 2026 09:39:59 -0600
Subject: [PATCH] Reduce loot spread


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index a4e743925d2e9c5b3771033097cc582b6edd3e13..d76aaa5230a8f6b6ebd5e9c7eb95912e07a65ebc 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4244,7 +4244,7 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         }
 
         if (randomly) {
-            float pow = this.random.nextFloat() * 0.5F;
+            float pow = this.random.nextFloat() * 0.3F; // Slice - Lower from 0.5 for less cartoonish loot spread
             float dir = this.random.nextFloat() * (float) (Math.PI * 2);
             entity.setDeltaMovement(-Mth.sin(dir) * pow, 0.2F, Mth.cos(dir) * pow);
         } else {
