From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryptite <cryptite@gmail.com>
Date: Thu, 15 Jan 2026 08:08:47 -0600
Subject: [PATCH] Add BlockDestroyedByNeighborEvent


diff --git a/net/minecraft/server/level/ServerPlayerGameMode.java b/net/minecraft/server/level/ServerPlayerGameMode.java
index 81487e9840845de76f58e83cc57b173b5945bab4..1623dcbb933f1905f4b2d0dc291c1406103618e3 100644
--- a/net/minecraft/server/level/ServerPlayerGameMode.java
+++ b/net/minecraft/server/level/ServerPlayerGameMode.java
@@ -425,6 +425,7 @@ public class ServerPlayerGameMode {
         this.level.captureDrops = new java.util.ArrayList<>();
         // CraftBukkit end
         BlockState adjustedState = block.playerWillDestroy(this.level, pos, state, this.player);
+        level.pendingPlayerBlockEvents.put(pos, new Level.PendingBlockEvent(pos, this.player)); // Paper
         boolean changed = this.level.removeBlock(pos, false);
         if (SharedConstants.DEBUG_BLOCK_BREAK) {
             LOGGER.info("server broke {} {} -> {}", pos, adjustedState, this.level.getBlockState(pos));
@@ -450,6 +451,7 @@ public class ServerPlayerGameMode {
         // CraftBukkit start
         List<net.minecraft.world.entity.item.ItemEntity> itemsToDrop = this.level.captureDrops; // Paper - capture all item additions to the world
         this.level.captureDrops = null; // Paper - capture all item additions to the world; Remove this earlier so that we can actually drop stuff
+        level.pendingPlayerBlockEvents.remove(pos); // Paper
         if (event.isDropItems()) {
             org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockDropItemEvent(bblock, bState, this.player, itemsToDrop); // Paper - capture all item additions to the world
         }
diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index 00861318771cd184c9f75a9a036deee9ec2ba310..d4f3cd1e232b8c183543ddf64bcbc4d8876cc750 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -381,6 +381,7 @@ public final class ItemStack implements DataComponentHolder, ItemInstance {
             DataComponentPatch previousPatch = this.components.asPatch();
             int previousCount = this.getCount();
             ServerLevel level = (ServerLevel) context.getLevel();
+            if (player != null) level.pendingPlayerBlockEvents.put(pos, new Level.PendingBlockEvent(pos, player)); // Paper
             boolean isBonemeal = usedItem == Items.BONE_MEAL;
 
             if (!(usedItem instanceof BucketItem)) {
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 21878bd770f6c0bc10dd0a67be5bd94d7e16f741..e39c28fad5c54be5303d9a0ab2fd167e447e8a41 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -174,6 +174,28 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     public final Map<ServerExplosion.CacheKey, Float> explosionDensityCache = new java.util.HashMap<>(); // Paper - Optimize explosions
     public java.util.ArrayDeque<net.minecraft.world.level.block.RedstoneTorchBlock.Toggle> redstoneUpdateInfos; // Paper - Faster redstone torch rapid clock removal; Move from Map in BlockRedstoneTorch to here
 
+    // Paper start - Holder class used to track what Player is responsible the last block event
+    public static class PendingBlockEvent {
+
+        public final BlockPos block;
+        public final Player player;
+        public @Nullable BlockPos sourceBlock;
+
+        public PendingBlockEvent(BlockPos block, Player player) {
+            this(block, player, null);
+        }
+
+        public PendingBlockEvent(BlockPos block, Player player, @Nullable BlockPos sourceBlock) {
+            this.block = block;
+            this.player = player;
+            this.sourceBlock = sourceBlock;
+        }
+
+    }
+    public final Map<BlockPos, PendingBlockEvent> pendingPlayerBlockEvents = new java.util.HashMap<>();
+    // Paper end
+
+
     public CraftWorld getWorld() {
         return this.world;
     }
@@ -1202,6 +1224,17 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
             return false;
         }
 
+        // Paper start
+        PendingBlockEvent blockEvent = pendingPlayerBlockEvents.get(pos);
+        if (blockEvent != null && blockEvent.sourceBlock != null) {
+            io.papermc.paper.event.block.BlockDestroyedByNeighborEvent event =
+                    new io.papermc.paper.event.block.BlockDestroyedByNeighborEvent(org.bukkit.craftbukkit.block.CraftBlock.at(this, pos),
+                            (org.bukkit.entity.Player) blockEvent.player.getBukkitEntity(),
+                            org.bukkit.craftbukkit.block.CraftBlock.at(this, blockEvent.sourceBlock));
+            event.callEvent();
+        }
+        // Paper end
+
         // Paper start - BlockDestroyEvent; while the above removeBlock method looks very similar
         // they are NOT used with same intent and the above should not fire this event. The above method is more of a BlockSetToAirEvent,
         // it doesn't imply destruction of a block that plays a sound effect / drops an item.
@@ -1703,6 +1736,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
                 this.capturedBlockEntities.put(pos.immutable(), blockEntity);
                 return;
             }
+            pendingPlayerBlockEvents.remove(pos); // Paper
             // CraftBukkit end
             this.getChunkAt(pos).addAndRegisterBlockEntity(blockEntity);
         }
diff --git a/net/minecraft/world/level/block/DoublePlantBlock.java b/net/minecraft/world/level/block/DoublePlantBlock.java
index 8d8f558da8643a62130318e24b7d7a88addff9b7..74e786d065650fec8a57e53f1387e97584b05f33 100644
--- a/net/minecraft/world/level/block/DoublePlantBlock.java
+++ b/net/minecraft/world/level/block/DoublePlantBlock.java
@@ -124,6 +124,16 @@ public class DoublePlantBlock extends VegetationBlock {
         if (part == DoubleBlockHalf.UPPER) {
             BlockPos bottomPos = pos.below();
             BlockState bottomState = level.getBlockState(bottomPos);
+
+            Level.PendingBlockEvent blockEvent = level.pendingPlayerBlockEvents.remove(pos);
+            if (blockEvent != null) {
+                io.papermc.paper.event.block.BlockDestroyedByNeighborEvent event =
+                        new io.papermc.paper.event.block.BlockDestroyedByNeighborEvent(org.bukkit.craftbukkit.block.CraftBlock.at(level, bottomPos),
+                                (org.bukkit.entity.Player) blockEvent.player.getBukkitEntity(),
+                                org.bukkit.craftbukkit.block.CraftBlock.at(level, pos));
+                if (!event.callEvent()) return;
+            }
+
             if (bottomState.is(state.getBlock()) && bottomState.getValue(HALF) == DoubleBlockHalf.LOWER) {
                 BlockState blockState = bottomState.getFluidState().is(Fluids.WATER) ? Blocks.WATER.defaultBlockState() : Blocks.AIR.defaultBlockState();
                 level.setBlock(bottomPos, blockState, Block.UPDATE_ALL | Block.UPDATE_SUPPRESS_DROPS);
diff --git a/net/minecraft/world/level/block/state/BlockBehaviour.java b/net/minecraft/world/level/block/state/BlockBehaviour.java
index bebfe5b72c1dd812c480de3311ad36ca8d96466b..43284a2219cc9eba23ac7dbdea14f779f48c8c22 100644
--- a/net/minecraft/world/level/block/state/BlockBehaviour.java
+++ b/net/minecraft/world/level/block/state/BlockBehaviour.java
@@ -871,9 +871,22 @@ public abstract class BlockBehaviour implements FeatureElement {
 
         public final void updateNeighbourShapes(final LevelAccessor level, final BlockPos pos, final @Block.UpdateFlags int updateFlags, final int updateLimit) {
             BlockPos.MutableBlockPos blockPos = new BlockPos.MutableBlockPos();
+            BlockState blockState = level.getBlockState(pos); // Slice
 
             for (Direction direction : BlockBehaviour.UPDATE_SHAPE_ORDER) {
                 blockPos.setWithOffset(pos, direction);
+
+                // Paper start - Propagate the PendingBlockEvent from the current blockPos to the next block
+                // if it will break (!canSurvive)
+                if (blockState.getBukkitMaterial() == org.bukkit.Material.AIR && !level.getBlockState(blockPos).canSurvive(level, blockPos)) {
+                    Level.PendingBlockEvent blockEvent = ((Level) level).pendingPlayerBlockEvents.get(pos);
+                    if (blockEvent != null) {
+                        BlockPos blockPosCopy = blockPos.immutable();
+                        ((Level) level).pendingPlayerBlockEvents.put(blockPosCopy, new Level.PendingBlockEvent(blockPosCopy, blockEvent.player, pos));
+                    }
+                }
+                // Paper end
+
                 level.neighborShapeChanged(direction.getOpposite(), blockPos, pos, this.asState(), updateFlags, updateLimit);
             }
         }
